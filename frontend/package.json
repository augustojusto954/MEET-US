    "quasar": "^2.17.0",
    "socket.io-client": "^4.8.0",
    "sql.js": "^1.11.0",
    "vue": "^3.5.12",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "^3.10.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^9.29.0",
    "prettier": "^3.3.3",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
