    "build:spa": "quasar build -m spa",
    "build:electron": "quasar build -m electron",
    "lint": "eslint --ext .js,.vue ./",
    "format": "prettier --write \"**/*.{js,vue,json,md}\"",
    "test": "vitest"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.12",
    "axios": "^1.7.7",
    "meet-us": "file:..",
